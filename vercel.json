{
  "builds": [
    {
      "src": "*.php",
      "use": "vercel-php@0.9.0",
      "config": { "includeFiles": ["includes/**", "data/**"] }
    },
    {
      "src": "admin/*.php",
      "use": "vercel-php@0.9.0",
      "config": { "includeFiles": ["includes/**", "data/**"] }
    },
    { "src": "assets/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "handle": "filesystem" },
    { "src": "/", "dest": "/index.php" },
    { "src": "/admin/?$", "dest": "/admin/index.php" },
    { "src": "/(.+)", "dest": "/index.php" }
  ]
}
